<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".LoginActivity">

    <!-- Ambient concentric circular decorative background matching Onboarding -->
    <View
        android:id="@+id/ambientCircleOuter"
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_marginTop="-200dp"
        android:alpha="0.35"
        android:background="@drawable/bg_circle_ambient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/ambientCircleInner"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="-120dp"
        android:alpha="0.45"
        android:background="@drawable/bg_circle_ambient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Optional Back Button (Visible when invoked from Profile / Security settings) -->
    <ImageView
        android:id="@+id/btnLoginBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/profile_title"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/teal_primary"
        tools:visibility="visible" />

    <!-- Top Lock Icon Badge -->
    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="56dp"
        android:contentDescription="@string/login_title"
        android:src="@drawable/ic_lock_outline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dynamic Title (e.g. Welcome Back / Create 6-Digit PIN) -->
    <TextView
        android:id="@+id/tvLoginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/login_title"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLockIcon" />

    <!-- Dynamic Subtitle -->
    <TextView
        android:id="@+id/tvLoginSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/login_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLoginTitle" />

    <!-- 6 PIN Squares Container -->
    <LinearLayout
        android:id="@+id/pinBoxesContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLoginSubtitle">

        <TextView
            android:id="@+id/tvPin1"
            android:layout_width="46dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_pin_box"
            android:gravity="center"
            android:textColor="@color/teal_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="•" />

        <TextView
            android:id="@+id/tvPin2"
            android:layout_width="46dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_pin_box"
            android:gravity="center"
            android:textColor="@color/teal_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="•" />

        <TextView
            android:id="@+id/tvPin3"
            android:layout_width="46dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_pin_box"
            android:gravity="center"
            android:textColor="@color/teal_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="•" />

        <TextView
            android:id="@+id/tvPin4"
            android:layout_width="46dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_pin_box"
            android:gravity="center"
            android:textColor="@color/teal_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="•" />

        <TextView
            android:id="@+id/tvPin5"
            android:layout_width="46dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_pin_box"
            android:gravity="center"
            android:textColor="@color/teal_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="•" />

        <TextView
            android:id="@+id/tvPin6"
            android:layout_width="46dp"
            android:layout_height="54dp"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/bg_pin_box"
            android:gravity="center"
            android:textColor="@color/teal_dark"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="•" />
    </LinearLayout>

    <!-- Forgot PIN / Info text (Shown during App Unlock) -->
    <TextView
        android:id="@+id/tvForgotPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        android:text="@string/forgot_pin"
        android:textColor="@color/teal_primary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pinBoxesContainer" />

    <!-- On-screen Custom Numeric Keypad -->
    <GridLayout
        android:id="@+id/numericKeypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="36dp"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvForgotPin"
        app:layout_constraintVertical_bias="0.8">

        <!-- Row 1: 1, 2, 3 -->
        <TextView
            android:id="@+id/btnKey1"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnKey2"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnKey3"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Row 2: 4, 5, 6 -->
        <TextView
            android:id="@+id/btnKey4"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="4"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnKey5"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnKey6"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="6"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Row 3: 7, 8, 9 -->
        <TextView
            android:id="@+id/btnKey7"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="7"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnKey8"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="8"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnKey9"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="9"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Row 4: Empty, 0, Backspace -->
        <View
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp" />

        <TextView
            android:id="@+id/btnKey0"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/btnKeyBackspace"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_keypad_key"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/clear_btn"
                android:src="@drawable/ic_backspace" />
        </FrameLayout>

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
