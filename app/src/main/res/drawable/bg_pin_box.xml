<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active / Filled digit state -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/white" />
            <stroke android:width="2dp" android:color="@color/teal_primary" />
        </shape>
    </item>

    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/white" />
            <stroke android:width="2dp" android:color="@color/teal_primary" />
        </shape>
    </item>

    <!-- Default state: soft mint surface with clean border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/surface_item" />
            <stroke android:width="1.5dp" android:color="@color/input_border" />
        </shape>
    </item>
</selector>
